html, body {
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background: linear-gradient(135deg, #f5f7ff, #edf9f4);
  color: #1f2937;
}

* {
  box-sizing: border-box;
}

button,
input,
select {
  font: inherit;
}

.page-shell {
  max-width: 1100px;
  margin: 0 auto;
  padding: 40px 20px 80px;
}

.hero-card {
  background: linear-gradient(135deg, #1d4ed8, #0f766e);
  color: white;
  border-radius: 28px;
  padding: 32px 28px;
  box-shadow: 0 20px 40px rgba(29, 78, 216, 0.18);
  margin-bottom: 28px;
}

.badge {
  display: inline-block;
  background: rgba(255, 255, 255, 0.18);
  border: 1px solid rgba(255, 255, 255, 0.25);
  padding: 8px 14px;
  border-radius: 999px;
  font-weight: 700;
  margin-bottom: 18px;
}

.hero-card h1 {
  margin: 0 0 12px;
  font-size: clamp(2rem, 4vw, 3.2rem);
  line-height: 1.2;
}

.hero-card p {
  margin: 0;
  font-size: 1.06rem;
  max-width: 720px;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.9);
}

.panel,
.result-panel {
  background: rgba(255, 255, 255, 0.76);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 24px;
  padding: 24px;
  box-shadow: 0 15px 35px rgba(15, 23, 42, 0.08);
}

.form-grid {
  display: grid;
  gap: 22px;
}

.field-group {
  display: grid;
  gap: 12px;
}

.field-group label {
  font-weight: 700;
  color: #0f172a;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.chip {
  border: 1px solid #cbd5e1;
  background: white;
  color: #0f172a;
  padding: 12px 18px;
  border-radius: 999px;
  font-weight: 700;
  cursor: pointer;
  transition: 0.2s ease;
}

.chip.active {
  background: #1d4ed8;
  color: white;
  border-color: #1d4ed8;
}

select,
input[type='file'] {
  width: 100%;
  border: 1px solid #cbd5e1;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.95);
  padding: 14px 16px;
  color: #111827;
}

.upload-box small {
  color: #475569;
}

.submit-btn {
  border: none;
  border-radius: 16px;
  background: linear-gradient(135deg, #16a34a, #10b981);
  color: white;
  font-weight: 800;
  padding: 16px 22px;
  cursor: pointer;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.submit-btn:hover {
  transform: translateY(-1px);
}

.submit-btn:disabled {
  opacity: 0.75;
  cursor: wait;
}

.alert {
  margin-top: 20px;
  border-radius: 14px;
  padding: 16px 18px;
  font-weight: 600;
}

.alert.error {
  background: #fff1f2;
  border: 1px solid #fecdd3;
  color: #9f1239;
}

.result-panel {
  margin-top: 28px;
}

.result-header {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  color: #334155;
  font-weight: 700;
  margin-bottom: 12px;
}

.result-panel h2 {
  margin: 0 0 22px;
  color: #0f172a;
  font-size: clamp(1.8rem, 3vw, 2.5rem);
}

.steps {
  display: grid;
  gap: 16px;
}

.step-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 18px;
  padding: 14px 16px;
}

.step-number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #dbeafe;
  color: #1d4ed8;
  font-weight: 800;
  flex-shrink: 0;
}

.step-item p {
  margin: 0;
  color: #1f2937;
  line-height: 1.8;
}

.final-box {
  margin-top: 22px;
  background: linear-gradient(135deg, #ecfdf5, #eff6ff);
  border: 1px solid #a7f3d0;
  border-radius: 18px;
  padding: 20px 18px;
}

.final-box h3 {
  margin: 0 0 10px;
  color: #065f46;
}

.final-box p {
  margin: 0;
  line-height: 2;
  color: #0f172a;
  font-weight: 600;
}

.note {
  margin-top: 18px;
  padding: 12px 14px;
  border-radius: 12px;
  background: #fff7ed;
  color: #9a5b00;
  border: 1px solid #fed7aa;
  line-height: 1.8;
}

@media (max-width: 640px) {
  .page-shell {
    padding-top: 26px;
  }

  .panel,
  .result-panel,
  .hero-card {
    padding: 18px 16px;
    border-radius: 18px;
  }
}
